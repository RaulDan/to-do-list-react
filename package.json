{
  "name": "to-do-list-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "html-webpack-plugin": "^5.6.6",
    "webpack": "^5.106.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:mock-server": "node static-mock-server/server.js",
    "start-all-react": "concurrently \"npm run start\" \"npm run start:mock-server\"",
    "build": "react-scripts build",
    "build:federation": "webpack --config webpack.federation.config.cjs --mode production",
    "start:federation": "webpack serve --config webpack.federation.config.cjs --mode development",
    "build-src": "react-scripts build && node afterBuild.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
