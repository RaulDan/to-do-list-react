{
  "name": "to-do-list-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:mock-server": "node static-mock-server/server.js",
    "prestart-all-react": "npm run build:single-spa",
    "start-all-react": "concurrently -k -n standalone,api,watch \"npm run start\" \"npm run start:mock-server\" \"npm run watch:single-spa\"",
    "build": "react-scripts build",
    "build-src": "react-scripts build && node afterBuild.js",
    "test": "react-scripts test",
    "build:single-spa": "node build-single-spa.mjs",
    "watch:single-spa": "node build-single-spa.mjs --watch",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
